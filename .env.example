# MiniMax — used by TTS, voice clone, and voice design.
# International: https://api.minimax.io
# China: https://api.minimaxi.com

MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io

# Auth — email OTP is the default. Google is optional.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Optional OAuth (works when the server can reach Google).
# Create credentials: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI:
#   http://localhost:3000/api/auth/callback/google
#   https://your-domain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Tencent Cloud DirectMail (SES) for login codes.
# Region is usually ap-guangzhou or ap-hongkong.
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
# TENCENT_SES_REGION=ap-hongkong
# TENCENT_SES_FROM=Voxify <noreply@mail.your-domain.com>
# TENCENT_SES_TEMPLATE_ID=

# Local SQLite user database (created automatically).
# VOXIFY_DB_PATH=
